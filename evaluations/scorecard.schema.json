              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "rating": {
                    "type": "integer"
                  }
                },
                "required": [
                  "rating"
                ]
              },
              "then": {
                "properties": {
                  "evidence_ids": {
                    "minItems": 1
                  },
                  "rationale": {
                    "minLength": 10
                  }
                }
              }
            }
          ]
        },
