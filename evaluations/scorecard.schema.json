              }
            }
          ]
        }
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "evidence_ids",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_TESTED",
            "PASS",
            "FAIL"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "owner_approved": {
      "type": "boolean"
    },
    "total_score": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "not_tested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_notes": {
      "type": "string"
    }
  }
